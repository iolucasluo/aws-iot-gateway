GATEWAY_ENVIRONMENT=staging
GATEWAY_LISTEN_ADDRESS=:14080
AWS_REGION=ap-east-1
AWS_IOT_DEVICE_POLICY_NAME=aws-iot-gateway-staging-device
AWS_IOT_TOPIC_PREFIX=aws-iot-gateway-staging
# Direct MQTT ACK subscription is development-only; deployed staging uses IoT Rule -> SQS -> event-worker.
AWS_IOT_DIRECT_ACK_SUBSCRIBER_ENABLED=false
AWS_IOT_CREDENTIAL_PROVIDER_ENDPOINT=replace.credentials.iot.ap-east-1.amazonaws.com
AWS_IOT_ROLE_ALIAS=aws-iot-gateway-staging-kvs
AWS_IOT_SHADOW_NAME=internal-aws
AWS_IOT_INGEST_QUEUE_URL=https://sqs.ap-east-1.amazonaws.com/000000000000/aws-iot-gateway-staging-ingest
AWS_KVS_CHANNEL_PREFIX=aws-iot-gateway-staging-
AWS_S3_MEDIA_BUCKET=aws-iot-gateway-staging-media-example
TIME_BOOTSTRAP_KEY_ID=time-staging-g1
TIME_BOOTSTRAP_SIGNER=aws-kms
TIME_BOOTSTRAP_KMS_KEY_ID=alias/aws-iot-gateway-staging-time-bootstrap

# Use deployment secrets in real environments. These values are non-working examples.
DATABASE_URL=postgres://gateway:replace-at-deploy@postgres.invalid:5432/gateway?sslmode=require
# ECS may omit DATABASE_URL and inject these five fields from the RDS-managed secret instead.
# PGHOST=postgres.invalid
# PGPORT=5432
# PGDATABASE=gateway
# PGUSER=gateway
# PGPASSWORD=replace-at-deploy
REDIS_URL=rediss://:replace-at-deploy@redis.invalid:6379/0

# Internal apps are deployment-owned. No login, self-service credential, or CRUD API exists.
# webhook_url and webhook_secret are optional but must be configured together.

# ── ExploreX 平台面（独立部署单元 cmd/explorex-platform-api，默认 :14081）────────
# 平台面与 gateway 共用同一个 KEK（gateway 用它解密 DB 凭证；平台面用它封装项目凭证与
# webhook secret）。真实值来自部署秘密提供方，不写进仓库。development 之外必填。
PLATFORM_CREDENTIAL_KEK=
PLATFORM_CREDENTIAL_KEK_ID=kek-v1
PLATFORM_LISTEN_ADDRESS=:14081
# development 之外必填，且必须是显式 http(s) origin（CORS 禁止通配）。
PLATFORM_CORS_ALLOWED_ORIGINS=https://admin-console.invalid,https://developer-portal.invalid,https://manufacturer-portal.invalid
# 设备 I/O 与 OTA 代理目标＝gateway 内部 API 地址（同 VPC/内网）。
PLATFORM_GATEWAY_INTERNAL_BASE_URL=http://gateway.invalid:14080

INTERNAL_APPS_JSON=[{"id":"livpet-staging","api_key":"replace-livpet-key","api_secret":"replace-livpet-secret","webhook_url":"https://livpet.invalid/v1/internal/webhooks/explorex","webhook_secret":"replace-webhook-secret","webhook_event_types":["feeding_done","motion_detected","pet_detected"]},{"id":"demo-staging","api_key":"replace-demo-key","api_secret":"replace-demo-secret"}]
