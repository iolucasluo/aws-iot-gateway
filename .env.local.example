# Copy to .env.dev, .env.cwj, or another developer-owned .env.<name> file.
# Real .env.* files are ignored. AWS credentials come from the standard AWS SDK chain.
GATEWAY_ENVIRONMENT=development
GATEWAY_LISTEN_ADDRESS=:14080

# Reuse a developer-owned PostgreSQL/Redis process when these ports already listen.
# URLs must use loopback and the declared ports; only DATABASE_URL may use ?sslmode=disable.
# Keep data isolated with a dedicated PostgreSQL database and Redis DB index.
GATEWAY_LOCAL_POSTGRES_PORT=5432
GATEWAY_LOCAL_REDIS_PORT=6379
GATEWAY_LOCAL_POSTGRES_USER=gateway
GATEWAY_LOCAL_POSTGRES_PASSWORD=gateway-local-only
GATEWAY_LOCAL_POSTGRES_DATABASE=aws_iot_gateway
DATABASE_URL=postgres://gateway:gateway-local-only@127.0.0.1:5432/aws_iot_gateway?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/1

# Fill these with the authorized dev/staging AWS resource names. Do not put AWS access keys here.
AWS_PROFILE=replace-with-authorized-profile
AWS_REGION=ap-east-1
AWS_IOT_DEVICE_POLICY_NAME=replace-with-device-policy
AWS_IOT_TOPIC_PREFIX=replace-with-topic-prefix
# Optional local command ACK loop. Does not consume the shared staging SQS queue.
AWS_IOT_DIRECT_ACK_SUBSCRIBER_ENABLED=false
AWS_IOT_CREDENTIAL_PROVIDER_ENDPOINT=replace.credentials.iot.ap-east-1.amazonaws.com
AWS_IOT_ROLE_ALIAS=replace-with-role-alias
AWS_IOT_SHADOW_NAME=internal-aws
AWS_IOT_INGEST_QUEUE_URL=https://sqs.ap-east-1.amazonaws.com/000000000000/replace-with-ingest-queue
AWS_KVS_CHANNEL_PREFIX=replace-with-channel-prefix-
AWS_S3_MEDIA_BUCKET=replace-with-media-bucket
TIME_BOOTSTRAP_KEY_ID=time-local-g1
TIME_BOOTSTRAP_SIGNER=local
TIME_BOOTSTRAP_LOCAL_PRIVATE_KEY_PATH=.local/device-bootstrap/<developer>/time-bootstrap-private.pem

# Internal apps are local environment facts. No developer login or credential CRUD is introduced.
INTERNAL_APPS_JSON='[{"id":"demo-local","api_key":"demo-local-key","api_secret":"replace-with-local-secret"}]'

# Used only by the workspace local-dev skill when launching the Flutter demo app.
DEMO_INTERNAL_APP_ID=demo-local
DEMO_BINDING_EXTERNAL_USER_ID=aws-iot-demo-user
DEMO_API_BASE_URL=http://replace-with-this-mac-lan-ip:14080
