# Operator-owned single-node signaling environment. Copy outside Git and chmod
# 0600. The public base URL is returned to App/feeder and must be LAN/WAN reachable.
EXPLOREX_SIGNAL_PUBLIC_BASE_URL=ws://cn-staging.example.invalid:28084
# Empty means direct P2P only. Configure the single-node coturn public/LAN URL
# and matching operator-owned credential before WAN/TURN acceptance.
EXPLOREX_SIGNAL_ICE_SERVERS_JSON=[]

# EXPLOREX_SIGNAL_LISTEN_ADDRESS and the shared auth token are injected by Compose.
