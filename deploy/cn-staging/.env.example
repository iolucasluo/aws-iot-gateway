# Copy to a developer-owned ignored file outside this directory, for example:
#   cp deploy/cn-staging/.env.example .env.cn-staging.local
# Never commit the copied file or use real cloud credentials in it.
# Stateful services stay loopback-only. Set CN_STAGING_EDGE_BIND_ADDRESS to a
# controlled LAN/public interface only for a trusted protocol harness; feeder
# HIL waits for the Phase 3 MQTTS/mTLS/ACL profile.
CN_STAGING_STATE_BIND_ADDRESS=127.0.0.1
CN_STAGING_EDGE_BIND_ADDRESS=127.0.0.1
CN_STAGING_POSTGRES_USER=gateway
CN_STAGING_POSTGRES_PASSWORD=replace-with-local-secret
CN_STAGING_POSTGRES_DATABASE=aws_iot_gateway_cn_staging
CN_STAGING_POSTGRES_PORT=55432
CN_STAGING_REDIS_PASSWORD=replace-with-local-secret
CN_STAGING_REDIS_PORT=56379
CN_STAGING_MQTT_PORT=51883
CN_STAGING_MQTTS_PORT=51884
CN_STAGING_MQTT_TLS_DIR=/opt/explorex-cn-staging/runtime/mqtt-tls
CN_STAGING_MQTT_ACL_FILE=/opt/explorex-cn-staging/runtime/mosquitto.mtls.acl
CN_STAGING_TURN_REALM=cn-staging.local
CN_STAGING_TURN_USER=turn-local
CN_STAGING_TURN_PASSWORD=replace-with-local-secret
CN_STAGING_TURN_UDP_PORT=53478
CN_STAGING_TURN_TCP_PORT=53478
CN_STAGING_TURN_RELAY_MIN_PORT=49160
CN_STAGING_TURN_RELAY_MAX_PORT=49200
CN_STAGING_MINIO_ROOT_USER=minio-local
CN_STAGING_MINIO_ROOT_PASSWORD=replace-with-local-secret
CN_STAGING_MINIO_API_PORT=59000
CN_STAGING_MINIO_CONSOLE_PORT=59001
