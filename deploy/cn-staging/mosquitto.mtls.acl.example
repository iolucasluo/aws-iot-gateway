# The TLS client certificate subject CN is the MQTT username.
# Gateway publishes commands and consumes device replies/telemetry.
user gateway-cn-staging
topic write cmd/cn-staging/+/req
topic read cmd/cn-staging/+/res
topic read dt/cn-staging/+/status
topic read dt/cn-staging/+/lwt
topic read dt/cn-staging/+/event

# Activated feeder certificate CN equals its device SN. Mosquitto exposes that
# identity as %u, so each device can only access its own command and telemetry
# topics without requiring an ACL rewrite after every activation.
pattern read cmd/cn-staging/%u/req
pattern write cmd/cn-staging/%u/res
pattern write dt/cn-staging/%u/status
pattern write dt/cn-staging/%u/lwt
pattern write dt/cn-staging/%u/event
