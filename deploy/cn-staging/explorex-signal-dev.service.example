[Unit]
Description=ExploreX self-hosted realtime signaling (domestic staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=explorex-signal
Group=explorex-signal
EnvironmentFile=/opt/explorex/domestic-signal/config/signal.env
ExecStart=/opt/explorex/domestic-signal/current/explorex-signal
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/explorex/domestic-signal

[Install]
WantedBy=multi-user.target
