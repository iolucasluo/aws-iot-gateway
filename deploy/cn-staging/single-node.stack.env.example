# Copy to an ignored operator-owned file and replace all secrets/placeholders.
# These defaults are deliberately isolated from the existing DELL domestic stack.
CN_STAGING_STATE_BIND_ADDRESS=127.0.0.1
CN_STAGING_EDGE_BIND_ADDRESS=127.0.0.1

CN_STAGING_POSTGRES_USER=gateway
CN_STAGING_POSTGRES_PASSWORD=replace-with-local-secret
CN_STAGING_POSTGRES_DATABASE=gateway_cn_single_node
CN_STAGING_POSTGRES_PORT=65432
CN_STAGING_REDIS_PASSWORD=replace-with-local-secret
CN_STAGING_REDIS_PORT=56389

CN_STAGING_MQTT_PORT=61883
CN_STAGING_MQTTS_PORT=61884
CN_STAGING_MQTT_TLS_DIR=/opt/explorex-cn-single-node/runtime/mqtt-tls
CN_STAGING_MQTT_ACL_FILE=/opt/explorex-cn-single-node/runtime/mosquitto.mtls.acl

CN_STAGING_TURN_REALM=cn-single-node.local
CN_STAGING_TURN_USER=turn-local
CN_STAGING_TURN_PASSWORD=replace-with-local-secret
CN_STAGING_TURN_UDP_PORT=63478
CN_STAGING_TURN_TCP_PORT=63478
CN_STAGING_TURN_RELAY_MIN_PORT=49360
CN_STAGING_TURN_RELAY_MAX_PORT=49400

CN_STAGING_MINIO_ROOT_USER=minio-local
CN_STAGING_MINIO_ROOT_PASSWORD=replace-with-local-secret
CN_STAGING_MINIO_API_PORT=59010
CN_STAGING_MINIO_CONSOLE_PORT=59011

CN_STAGING_GATEWAY_IMAGE=explorex-cn-gateway:local
CN_STAGING_GATEWAY_ENV_FILE=/opt/explorex-cn-single-node/config/gateway.env
CN_STAGING_SIGNAL_ENV_FILE=/opt/explorex-cn-single-node/config/signal.env
CN_STAGING_RUNTIME_DIR=/opt/explorex-cn-single-node/runtime
CN_STAGING_REALTIME_AUTH_TOKEN=replace-with-local-secret
CN_STAGING_GATEWAY_PORT=24083
CN_STAGING_SIGNAL_PORT=28084
