# Start from gateway-single-node.env.example, then add these operator-owned OSS
# values. The composition uses the internal endpoint for Gateway calls while
# presigned URLs use the Internet endpoint below for feeder/App access.
GATEWAY_OBJECT_PUBLIC_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
GATEWAY_OBJECT_BUCKET=replace-with-media-bucket
GATEWAY_OBJECT_ACCESS_KEY_ID=replace-with-access-key-id
GATEWAY_OBJECT_ACCESS_KEY_SECRET=replace-with-access-key-secret

# 国内 runtime 的 OTA 是**显式 opt-in**：只有设置了这个设备可达的公网基址，
# gateway 才会构造 OTA service（artifact store 用上面 media_object 绑定的 OSS）。
# 不设置时 openapi/平台面代理的 OTA 路由返回 503 ota_service_unavailable；
# admin 只读 OTA 视图读数据库，不受影响。
OTA_DEVICE_DOWNLOAD_BASE_URL=https://api-staging.livpet.top
# Private JPEG event link is authenticated by Gateway HMAC + current device binding.
PET_PHOTO_PUBLIC_ORIGIN=https://api-staging.livpet.top
# ── ExploreX 平台面（与 gateway 同一台机器上的第二个进程，默认 :14081）──────────
# 两个进程必须共用同一个 KEK：gateway 用它解密 DB 凭证，平台面用它封装项目凭证与
# webhook secret。真实值由部署秘密提供方注入，不写进仓库。
PLATFORM_CREDENTIAL_KEK=
PLATFORM_CREDENTIAL_KEK_ID=kek-v1
PLATFORM_LISTEN_ADDRESS=:14081
PLATFORM_CORS_ALLOWED_ORIGINS=https://admin-console.invalid,https://developer-portal.invalid,https://manufacturer-portal.invalid
PLATFORM_GATEWAY_INTERNAL_BASE_URL=http://127.0.0.1:14080

