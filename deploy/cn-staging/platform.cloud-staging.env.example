# ExploreX 平台面（cmd/explorex-platform-api）的 cloud staging 运行环境。
# 复制到 /opt/explorex-cn-cloud-staging/config/platform.env（0600）；不要进 Git。
# 与 gateway.env 的关系：两者必须共用同一个 PLATFORM_CREDENTIAL_KEK —— gateway 用它解密
# DB 凭证（projects/api_credentials），平台面用它封装项目凭证与 webhook secret。
# 不一致的表现：DB 凭证验签 401 / 平台面项目路由 503。

GATEWAY_ENVIRONMENT=development

# 与 gateway.env 指向同一 PostgreSQL/Redis（容器网络内的服务名）。
DATABASE_URL=postgres://replace-with-user:replace-with-url-encoded-secret@postgres:5432/replace-with-database?sslmode=disable
REDIS_URL=redis://:replace-with-url-encoded-secret@redis:6379/1

# 32 字节 base64；生成：openssl rand -base64 32
PLATFORM_CREDENTIAL_KEK=replace-with-base64-32-bytes
PLATFORM_CREDENTIAL_KEK_ID=kek-v1

# 由 compose 覆盖为 0.0.0.0:14081；此处保留默认值以便单进程排查。
PLATFORM_LISTEN_ADDRESS=:14081

# 三门户同源访问，跨域不是必需；显式列出以便将来拆分域名。
PLATFORM_CORS_ALLOWED_ORIGINS=https://admin-staging.livpet.top,https://developer-staging.livpet.top,https://manufacturer-staging.livpet.top

# 设备 I/O 与 OTA 写操作的代理目标（compose 也会覆盖为容器网络地址）。
PLATFORM_GATEWAY_INTERNAL_BASE_URL=http://gateway-api:14080
