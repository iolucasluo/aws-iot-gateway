# Operator-owned single-node Gateway environment. Copy outside Git, chmod 0600,
# and replace every placeholder. Container-only paths resolve under the runtime
# directory mounted read-only at /run/explorex.
GATEWAY_ENVIRONMENT=development
GATEWAY_PROVIDER_MODE=domestic-dev
GATEWAY_PROVIDER_COMPOSITION_PATH=/run/explorex/composition.yaml
DATABASE_URL=postgres://gateway:replace-with-url-encoded-secret@postgres:5432/gateway_cn_single_node?sslmode=disable
REDIS_URL=redis://:replace-with-url-encoded-secret@redis:6379/1
INTERNAL_APPS_JSON='[{"id":"demo-domestic","api_key":"replace","api_secret":"replace"}]'

TIME_BOOTSTRAP_KEY_ID=time-domestic-dev-g1
TIME_BOOTSTRAP_SIGNER=local
TIME_BOOTSTRAP_LOCAL_PRIVATE_KEY_PATH=/run/explorex/time-signer.pem

# This endpoint is advertised to the feeder. It must be reachable outside the
# Docker network. Gateway itself connects through composition.yaml.
DOMESTIC_MQTT_ENDPOINT=mqtts://cn-staging.example.invalid:61884
DOMESTIC_MQTT_TOPIC_PREFIX=cn-staging
DOMESTIC_MQTT_CLIENT_ID=gateway-cn-staging
DOMESTIC_MQTT_CLIENT_CERT_PATH=/run/explorex/mqtt-tls/gateway-cn-staging.crt
DOMESTIC_MQTT_CLIENT_KEY_PATH=/run/explorex/mqtt-tls/gateway-cn-staging.key
DOMESTIC_CA_CERT_PATH=/run/explorex/mqtt-tls/ca.crt
DOMESTIC_CA_KEY_PATH=/run/explorex/identity-ca.key
DOMESTIC_SIGNER_PRIVATE_KEY_PATH=/run/explorex/time-signer.pem
DOMESTIC_SIGNER_KEY_ID=time-domestic-dev-g1


# ── ExploreX 平台面（与 gateway 同一台机器上的第二个进程，默认 :14081）──────────
# 两个进程必须共用同一个 KEK：gateway 用它解密 DB 凭证，平台面用它封装项目凭证与
# webhook secret。真实值由部署秘密提供方注入，不写进仓库。
PLATFORM_CREDENTIAL_KEK=
PLATFORM_CREDENTIAL_KEK_ID=kek-v1
PLATFORM_LISTEN_ADDRESS=:14081
PLATFORM_CORS_ALLOWED_ORIGINS=https://admin-console.invalid,https://developer-portal.invalid,https://manufacturer-portal.invalid
PLATFORM_GATEWAY_INTERNAL_BASE_URL=http://127.0.0.1:14080

# DOMESTIC_REALTIME_ENDPOINT and the shared auth token are injected by Compose
# so the Gateway uses the private application network and cannot drift from the
# signaling service secret.
