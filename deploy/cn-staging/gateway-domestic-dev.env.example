# Operator-owned DELL domestic-dev Gateway configuration.
# Keep the real copy outside Git-tracked paths with mode 0600.
GATEWAY_LISTEN_ADDRESS=192.168.11.131:14083
GATEWAY_ENVIRONMENT=development
GATEWAY_PROVIDER_MODE=domestic-dev
GATEWAY_PROVIDER_COMPOSITION_PATH=/opt/explorex/domestic-gateway-dev/config/composition.yaml
DATABASE_URL=postgres://gateway:<url-encoded-password>@127.0.0.1:55432/aws_iot_gateway_cn_domestic_dev?sslmode=disable
REDIS_URL=redis://:<url-encoded-password>@127.0.0.1:56379/3
INTERNAL_APPS_JSON='[{"id":"demo-domestic","api_key":"replace","api_secret":"replace"}]'

TIME_BOOTSTRAP_KEY_ID=time-domestic-dev-g1
TIME_BOOTSTRAP_SIGNER=local
TIME_BOOTSTRAP_LOCAL_PRIVATE_KEY_PATH=/opt/explorex/domestic-gateway-dev/runtime/time-signer.pem

DOMESTIC_MQTT_ENDPOINT=mqtts://192.168.11.131:51884
DOMESTIC_MQTT_TOPIC_PREFIX=cn-staging
DOMESTIC_MQTT_CLIENT_ID=gateway-cn-staging
DOMESTIC_MQTT_CLIENT_CERT_PATH=/opt/explorex-cn-staging/runtime/mqtt-tls/gateway-cn-staging.crt
DOMESTIC_MQTT_CLIENT_KEY_PATH=/opt/explorex-cn-staging/runtime/mqtt-tls/gateway-cn-staging.key
DOMESTIC_CA_CERT_PATH=/opt/explorex/domestic-gateway-dev/runtime/ca.crt
DOMESTIC_CA_KEY_PATH=/opt/explorex/domestic-gateway-dev/runtime/ca.key
DOMESTIC_SIGNER_PRIVATE_KEY_PATH=/opt/explorex/domestic-gateway-dev/runtime/time-signer.pem
DOMESTIC_SIGNER_KEY_ID=time-domestic-dev-g1

# Self-hosted realtime signaling; secret must match the ignored signaling service env.
DOMESTIC_REALTIME_ENDPOINT=http://192.168.11.131:18084
DOMESTIC_REALTIME_AUTH_TOKEN=replace-with-signaling-secret
