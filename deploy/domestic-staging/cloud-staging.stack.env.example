CN_STAGING_STATE_BIND_ADDRESS=127.0.0.1
CN_STAGING_EDGE_BIND_ADDRESS=0.0.0.0

CN_STAGING_POSTGRES_USER=gateway
CN_STAGING_POSTGRES_PASSWORD=replace-with-random-postgres-secret
CN_STAGING_POSTGRES_DATABASE=gateway_cn_cloud_staging
CN_STAGING_POSTGRES_PORT=55432

CN_STAGING_REDIS_PASSWORD=replace-with-random-redis-secret
CN_STAGING_REDIS_PORT=56379

CN_STAGING_MQTTS_PORT=8883
CN_STAGING_MQTT_TLS_DIR=/opt/explorex-cn-cloud-staging/runtime/mqtt-tls
CN_STAGING_MQTT_ACL_FILE=/opt/explorex-cn-cloud-staging/config/mosquitto.acl

CN_STAGING_TURN_REALM=turn-staging.livpet.top
CN_STAGING_TURN_USER=replace-with-turn-user
CN_STAGING_TURN_PASSWORD=replace-with-random-turn-secret
CN_STAGING_TURN_UDP_PORT=3478
CN_STAGING_TURN_TCP_PORT=3478
CN_STAGING_TURN_RELAY_MIN_PORT=49360
CN_STAGING_TURN_RELAY_MAX_PORT=49400
CN_CLOUD_PUBLIC_IP=replace-with-ecs-public-ip

CN_STAGING_GATEWAY_IMAGE=explorex-cn-gateway:replace-with-immutable-revision
CN_STAGING_GATEWAY_ENV_FILE=/opt/explorex-cn-cloud-staging/config/gateway.env
CN_STAGING_SIGNAL_ENV_FILE=/opt/explorex-cn-cloud-staging/config/signal.env
CN_STAGING_RUNTIME_DIR=/opt/explorex-cn-cloud-staging/runtime
CN_STAGING_REALTIME_AUTH_TOKEN=replace-with-random-signal-secret
